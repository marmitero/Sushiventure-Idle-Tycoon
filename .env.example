# Sushiventure Idle Tycoon — exemplos de configuração (VALORES FICTÍCIOS).
# Copie para .env (gitignored) e preencha somente com credenciais reais
# fornecidas pelo diretor. Nenhum destes valores é usado sem configuração
# explícita; ausências resultam em adaptadores "não configurado".

# Provedor de anúncios recompensados (Fase 9) — ex.: web rewarded compatível
VITE_ADS_PROVIDER=
VITE_ADS_PLACEMENT_DOUBLE_REVENUE=

# Pagamentos (Fase 9) — chave PUBLICA apenas; segredos ficam no backend
VITE_PAYMENTS_PROVIDER=
VITE_PAYMENTS_PUBLIC_KEY=

# Nuvem/auth (Fase 8) — ex.: Supabase
VITE_CLOUD_PROVIDER=
VITE_CLOUD_URL=
VITE_CLOUD_ANON_KEY=

# Analytics (opcional, respeitando privacidade)
VITE_ANALYTICS_PROVIDER=
